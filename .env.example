# Node/Express API port. Port 5000 is already taken by the legacy Spring Boot
# service during local development, which answers /api/auth/login with the same
# JSON envelope, so the Node API runs on 4000 by default. The Vite dev server
# reads this value for its /api proxy; override it with VITE_DEV_API_URL.
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
MONGO_URI=your_mongodb_connection_string_here
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
# Leave blank to keep receipt upload in "manual entry" mode; the API then answers
# POST /api/transactions/upload-receipt with 503 and a configuration message.
OCR_SPACE_API_KEY=
GEMINI_API_KEY=your_gemini_api_key_here
CHATBOT_PROVIDER=gemini
CHATBOT_MODEL=gemini-2.5-flash
