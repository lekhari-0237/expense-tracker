# Public build-time config for the frontend (Vite exposes only VITE_* variables).
#
# PRODUCTION: set VITE_API_URL to the deployed Node/Express API origin. Requests then
# go straight to that host instead of through the dev proxy, so the API must send CORS
# headers for this site's origin.
#   VITE_API_URL=https://expense-tracker-backend.onrender.com
# Leave both settings empty when the API is served behind the same origin as the site.
VITE_API_URL=
#
# LOCAL DEVELOPMENT ONLY (never bundled into the build): the port/host the Vite dev
# server proxies its relative "/api" calls to. If unset, frontend/vite.config.js uses
# the PORT value from backend/.env, then the root .env, then 5000. The legacy Spring
# Boot service holds port 5000 on this machine, so point this at the Node API:
#   VITE_DEV_API_URL=http://localhost:4000
VITE_DEV_API_URL=
